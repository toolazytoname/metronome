.webview-page {
  width: 100%;
  height: 100vh;
}
.fallback {
  padding: 48px 28px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.fallback-title {
  font-size: 18px;
  font-weight: 700;
  color: #2a211c;
}
.fallback-hint {
  font-size: 14px;
  color: #7a6b62;
  line-height: 1.5;
}
.fallback-url {
  font-size: 13px;
  color: #6549a3;
  word-break: break-all;
}
.fallback-copy {
  margin-top: 8px;
  background: #ff9a9e;
  color: #fff;
  font-size: 15px;
}
