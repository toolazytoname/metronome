<view class="container">

  <!-- 三颗同尺寸方块；分享用透明 button 覆盖，避免原生 button 默认高把行撑歪 -->
  <view class="bean-row">
    <view class="bean bean-share" hover-class="bean-hover" aria-label="Share">
      <button class="bean-hit" open-type="share" hover-class="none"></button>
      <view class="bean-icon"></view>
    </view>
    <view class="bean bean-info" hover-class="bean-hover" bindtap="onInfo" aria-label="Info">
      <view class="bean-icon"></view>
    </view>
    <view class="bean bean-lang" hover-class="bean-hover" bindtap="onLangToggle" aria-label="Switch language">
      <text class="bean-lang-text">{{i18n.lang_btn}}</text>
    </view>
  </view>

  <view class="card">
    <!-- 顶部：兔兔图标（马卡龙圆锥彩虹环） + 标题 -->
    <view class="header">
      <view class="bunny-ring">
        <image class="bunny-img" src="/images/bunny.png" mode="aspectFit"></image>
      </view>
      <text class="title">{{i18n.title}}</text>
    </view>

    <!-- 节拍指示器 -->
    <view class="beats-section">
      <view
        wx:for="{{beats}}"
        wx:key="index"
        class="beat {{item.className}} {{item.active ? 'pop' : ''}}"
      >{{item.num}}</view>
    </view>

    <!-- BPM 显示 -->
    <view class="bpm-section">
      <view class="bpm-display">
        <text class="bpm-val">{{bpm}}</text>
        <text class="bpm-unit">{{i18n.bpm}}</text>
        <view class="now-playing {{running ? 'playing' : ''}}">
          <view class="np-dot"></view>
          <text>{{nowPlayingText}}</text>
        </view>
        <view class="audio-note" wx:if="{{audioNote}}">{{audioNote}}</view>
      </view>
    </view>

    <!-- BPM 滑块 -->
    <view class="slider-wrap">
      <view class="slider-row">
        <view class="bpm-btn sm" bindtap="onBpmMinus">−</view>
        <slider
          min="40"
          max="208"
          value="{{bpm}}"
          bindchange="onBpmChange"
          bindchanging="onBpmChanging"
          backgroundColor="#ddf5e9"
          selected-color="#ff7b7b"
          block-color="#ffffff"
          block-size="28"
        />
        <view class="bpm-btn sm" bindtap="onBpmPlus">+</view>
      </view>
    </view>

    <!-- 播放按钮 -->
    <view class="control">
      <view class="play-btn {{running ? 'running' : ''}}" bindtap="onPlay">
        {{running ? '⏸' : '▶'}}
      </view>
    </view>
  </view>

  <!-- 设置面板 -->
  <view class="settings">
    <view class="toggle {{settingsOpen ? 'open' : ''}}" bindtap="onToggleSettings">
      <text>{{i18n.settings}}</text>
      <view class="toggle-arrow">▼</view>
    </view>
    <view class="panel {{settingsOpen ? 'open' : ''}}">
      <view class="panel-inner">

        <!-- 音效模式 -->
        <view class="section-title">{{i18n.section_sound}}</view>
        <view class="mode-row">
          <view
            class="mode-btn {{soundMode === 'traditional' ? 'active' : ''}}"
            bindtap="onModeChange"
            data-mode="traditional"
          >
            <text class="mode-icon">🥁</text>
            <text>{{i18n.sm_traditional}}</text>
          </view>
          <view
            class="mode-btn {{soundMode === 'uniform' ? 'active' : ''}}"
            bindtap="onModeChange"
            data-mode="uniform"
          >
            <text class="mode-icon">🎵</text>
            <text>{{i18n.sm_uniform}}</text>
          </view>
          <view
            class="mode-btn {{soundMode === 'voice' ? 'active' : ''}}"
            bindtap="onModeChange"
            data-mode="voice"
          >
            <text class="mode-icon">🗣️</text>
            <text>{{i18n.sm_voice}}</text>
          </view>

        </view>

        <!-- 节拍预设 -->
        <view class="section-title lemon">{{i18n.section_beat}}</view>
        <view class="time-grid">
          <view
            wx:for="{{timeSigs}}"
            wx:key="sig"
            class="time-btn {{currentSig === item.sig ? 'active' : ''}}"
            bindtap="onTimeSigChange"
            data-sig="{{item.sig}}"
          >
            {{item.sig}}
            <text class="time-label">{{item.label}}</text>
          </view>
        </view>

        <!-- 自定义节拍 -->
        <view class="section-title lav">{{i18n.section_custom}}</view>
        <view class="custom-row">
          <input
            type="number"
            class="custom-input"
            value="{{customBeats}}"
            bindinput="onCustomBeatsInput"
            min="1"
            max="16"
          />
          <text class="custom-sep">/</text>
          <input
            type="number"
            class="custom-input"
            value="{{customUnit}}"
            bindinput="onCustomUnitInput"
            min="1"
            max="16"
          />
          <view class="apply-btn" bindtap="onApplyCustom">{{i18n.apply}}</view>
        </view>

        <view class="section-title coral">{{i18n.section_volume}}</view>
        <view class="vol-row">
          <text class="vol-ico">🔊</text>
          <slider
            min="10"
            max="100"
            value="{{vol}}"
            bindchange="onVolChange"
            bindchanging="onVolChanging"
            backgroundColor="#ffe5e1"
            selected-color="#ff7b7b"
            block-color="#ffffff"
            block-size="24"
          />
          <text class="vol-val">{{vol}}</text>
        </view>

        <!-- 支持我们 —— 跳转 web-view 看捐赠页（小程序不允许直接扫码支付） -->
        <view class="donate-card">
          <text class="donate-title">❤️ {{i18n.donate_title}}</text>
          <text class="donate-desc">{{i18n.donate_desc}}</text>
          <view class="donate-btns">
            <view class="donate-btn primary" bindtap="onDonate" hover-class="donate-btn-hover">
              <text class="donate-btn-text">{{i18n.donate_btn_open}}</text>
              <text class="donate-btn-arrow">→</text>
            </view>
            <view class="donate-btn secondary" bindtap="onCopyUrl" hover-class="donate-btn-hover">
              <text class="donate-btn-text">{{i18n.donate_btn_copy}}</text>
            </view>
          </view>
          <text class="donate-tip">⚠ {{i18n.donate_tip}}</text>
        </view>

      </view>
    </view>
  </view>
</view>

<!-- iOS 静音提示（启发式：iOS 首次播放后 1.5s 弹出，✕ / 8s 自动消失） -->
<view class="silent-hint {{silentHintShow ? 'show' : ''}}">
  <text class="silent-ico">🔇</text>
  <view class="silent-body">
    <text class="silent-title">{{i18n.silent_title}}</text>
    <text class="silent-msg">{{i18n.silent_msg_part1}}<text class="em">{{i18n.silent_msg_em}}</text>{{i18n.silent_msg_part2}}</text>
  </view>
  <view class="silent-close" bindtap="onSilentHintClose">✕</view>
</view>
